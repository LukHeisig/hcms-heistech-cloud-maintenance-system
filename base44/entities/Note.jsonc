{
  "name": "Note",
  "type": "object",
  "properties": {
    "control_point_id": {
      "type": "string",
      "description": "ID kontroln\u00edho bodu"
    },
    "text": {
      "type": "string",
      "description": "Text pozn\u00e1mky"
    }
  },
  "required": [
