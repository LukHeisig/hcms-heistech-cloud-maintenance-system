    "text"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "superAdmin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "superAdmin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "manager"
          }
        }
      ]
