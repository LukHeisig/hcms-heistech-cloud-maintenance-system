{
  "name": "AissensSensor",
  "type": "object",
  "properties": {
    "sensor_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "machine_id": {
      "type": "string"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_report_type": {
      "type": "number"
    },
    "last_battery_level": {
      "type": "number"
    },
    "last_battery_voltage": {
      "type": "number"
    },
    "last_signal_strength": {
      "type": "number"
    },
    "last_temperature": {
      "type": "number"
    },
    "firmware_version": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "mac_address": {
      "type": "string"
    },
    "messages_total": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "sensor_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "read": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "update": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    }
  }
}