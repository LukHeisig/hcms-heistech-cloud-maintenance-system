{
  "name": "VseUnit",
  "type": "object",
  "properties": {
    "unit_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "machine_id": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "last_values_json": {
      "type": "string"
    },
    "messages_total": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "unit_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "read": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "update": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    }
  }
}