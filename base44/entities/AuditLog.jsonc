{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "Company",
        "Line",
        "Machine",
        "ControlPoint",
        "Issue",
        "User",
        "Auth"
      ],
      "description": "Typ entity, kter\u00e1 byla zm\u011bn\u011bna"
    },
    "entity_id": {
      "type": "string",
      "description": "ID ovlivn\u011bn\u00e9 entity (voliteln\u00e9 pro Auth ud\u00e1losti)"
    },
    "changed_by": {
      "type": "string",
      "format": "email",
      "description": "Email u\u017eivatele, kter\u00fd provedl zm\u011bnu"
    },
    "change_description": {
      "type": "string",
      "description": "Popis zm\u011bny"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "technician",
        "manager",
        "admin",
        "superAdmin"
      ],
      "description": "Role u\u017eivatele v dob\u011b proveden\u00ed zm\u011bny"
    },
    "company_id": {
      "type": "string",
      "description": "ID podniku, ke kter\u00e9mu se zm\u011bna vztahuje"
    },
    "company_name": {
      "type": "string",
      "description": "N\u00e1zev podniku v dob\u011b zm\u011bny"
    },
    "line_id": {
      "type": "string"
    },
    "line_name": {
      "type": "string"
    },
    "machine_id": {
      "type": "string",
      "description": "P\u016fvodn\u00ed ID stroje, zachov\u00e1no i po smaz\u00e1n\u00ed"
    },
    "machine_name": {
      "type": "string",
      "description": "N\u00e1zev stroje v dob\u011b zm\u011bny"
    },
    "point_name": {
      "type": "string"
    },
    "point_type": {
      "type": "string"
    },
    "point_number": {
      "type": "string"
    },
    "first_confirmation_date": {
      "type": "string",
      "description": "P\u016fvodn\u00ed datum prvn\u00edho potvrzen\u00ed bodu"
    },
    "action": {
      "type": "string",
      "description": "Operace, nap\u0159. delete"
    },
    "operation_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ]
    },
    "deletion_source": {
      "type": "string",
      "description": "Ru\u010dn\u00ed maz\u00e1n\u00ed, maz\u00e1n\u00ed stroje/linky nebo \u00faklid osi\u0159el\u00fdch bod\u016f"
    },
    "deleted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "entity_type",
    "changed_by",
    "change_description"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "superAdmin"
          }
        },
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "data.company_id": {
            "$in": "{{user.data.assigned_company_ids}}"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    }
  }
}