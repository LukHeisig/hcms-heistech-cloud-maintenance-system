{
  "name": "MqttMessage",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string"
    },
    "sensor_id": {
      "type": "string"
    },
    "payload_hex": {
      "type": "string"
    },
    "report_type": {
      "type": "number"
    },
    "payload_size": {
      "type": "number"
    }
  },
  "required": [
    "topic",
    "sensor_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "read": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "update": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    }
  }
}