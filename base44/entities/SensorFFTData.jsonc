{
  "name": "SensorFFTData",
  "type": "object",
  "properties": {
    "sensor_id": {
      "type": "string"
    },
    "sensor_data_id": {
      "type": "string"
    },
    "timestamp_unix": {
      "type": "number"
    },
    "dsp_version": {
      "type": "number"
    },
    "frequency_resolution": {
      "type": "number"
    },
    "true_resolution_hz": {
      "type": "number"
    },
    "report_len": {
      "type": "number"
    },
    "oa_x": {
      "type": "number"
    },
    "oa_y": {
      "type": "number"
    },
    "oa_z": {
      "type": "number"
    },
    "oa_acc_z": {
      "type": "number"
    },
    "acc_x_json": {
      "type": "string"
    },
    "acc_y_json": {
      "type": "string"
    },
    "acc_z_json": {
      "type": "string"
    },
    "vel_x_json": {
      "type": "string"
    },
    "vel_y_json": {
      "type": "string"
    },
    "vel_z_json": {
      "type": "string"
    },
    "env_z_json": {
      "type": "string"
    },
    "raw_z_preview_json": {
      "type": "string",
      "description": "Zmen\u0161en\u00fd n\u00e1hled \u010dasov\u00e9ho sign\u00e1lu Z: {step, values} (m/s\u00b2)"
    }
  },
  "required": [
    "sensor_id",
    "timestamp_unix"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "read": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "update": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    }
  }
}