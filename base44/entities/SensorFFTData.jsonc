{
  "name": "SensorFFTData",
  "type": "object",
  "properties": {
    "sensor_id": {
      "type": "string",
      "description": "ID senzoru"
    },
    "sensor_data_id": {
      "type": "string",
      "description": "ID z\u00e1znamu SensorData"
    },
    "timestamp_unix": {
      "type": "number",
      "description": "UNIX timestamp z hlavi\u010dky"
    },
    "dsp_version": {
      "type": "number",
      "description": "Verze DSP pipeline (1=p\u016fvodn\u00ed, 2=opraven\u00e1 normalizace)"
    },
    "frequency_resolution": {
      "type": "number",
      "description": "Rozte\u010d spektr\u00e1ln\u00edch \u010dar v Hz (po zero-paddingu)"
    },
    "true_resolution_hz": {
      "type": "number",
      "description": "Skute\u010dn\u00e1 rozli\u0161ovac\u00ed schopnost FFT v Hz (fs / d\u00e9lka segmentu)"
    },
    "report_len": {
      "type": "number",
      "description": "D\u00e9lka spektra (po\u010det bod\u016f na osu)"
    },
    "oa_x": {
      "type": "number"
    },
    "oa_y": {
      "type": "number"
    },
    "oa_z": {
      "type": "number"
    },
    "oa_acc_z": {
      "type": "number",
      "description": "RMS z acc_z spektra"
    },
    "acc_x_json": {
      "type": "string",
      "description": "JSON array prvn\u00edch 512 hodnot acc X spektra"
    },
    "acc_y_json": {
      "type": "string",
      "description": "JSON array prvn\u00edch 512 hodnot acc Y spektra"
    },
    "acc_z_json": {
      "type": "string",
      "description": "JSON array prvn\u00edch 512 hodnot acc Z spektra"
    },
    "vel_x_json": {
      "type": "string",
      "description": "JSON array prvn\u00edch 512 hodnot vel X spektra"
    },
    "vel_y_json": {
      "type": "string",
      "description": "JSON array prvn\u00edch 512 hodnot vel Y spektra"
    },
    "vel_z_json": {
      "type": "string",
      "description": "JSON array prvn\u00edch 512 hodnot vel Z spektra"
    },
    "env_z_json": {
      "type": "string",
      "description": "JSON array spektra ob\u00e1lky"
    }
  },
  "required": [
    "sensor_id",
    "timestamp_unix"
  ]
}