{
  "name": "VibrationSensorAssignment",
  "type": "object",
  "properties": {
    "machine_id": {
      "type": "string"
    },
    "schema_row_index": {
      "type": "number"
    },
    "sensor_id": {
      "type": "string"
    },
    "vel_standard_id": {
      "type": "string"
    },
    "acc_standard_id": {
      "type": "string"
    },
    "temp_standard_id": {
      "type": "string"
    },
    "bearing_id": {
      "type": "string"
    },
    "orientation": {
      "type": "string",
      "default": "VAH",
      "description": "Orientace os X,Y,Z (V=vertik\u00e1ln\u00ed, A=axi\u00e1ln\u00ed, H=horizont\u00e1ln\u00ed), nap\u0159. VAH. Pou\u017eije se jen p\u0159i re\u017eimu stroje 'ka\u017ed\u00fd jinak'."
    }
  },
  "required": [
    "machine_id",
    "schema_row_index"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "read": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "update": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    }
  }
}