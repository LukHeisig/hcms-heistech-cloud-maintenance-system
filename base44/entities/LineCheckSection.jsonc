{
  "name": "LineCheckSection",
  "type": "object",
  "properties": {
    "line_id": {
      "type": "string",
      "description": "ID linky"
    },
    "name": {
      "type": "string",
      "description": "N\u00e1zev sekce (nap\u0159. Tlak vedlej\u0161\u00ed, Mno\u017estv\u00ed, Teplota vzduchu)"
    },
    "order_index": {
      "type": "number",
      "description": "Po\u0159ad\u00ed zobrazen\u00ed sekce",
      "default": 0
    }
  },
  "required": [
    "line_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "superAdmin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "manager"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "superAdmin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "superAdmin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "manager"
          }
        }
      ]
    }
  }
}