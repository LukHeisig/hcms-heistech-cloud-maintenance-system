{
  "name": "Machine",
  "type": "object",
  "properties": {
    "line_id": {
      "type": "string",
      "description": "ID linky"
    },
    "parent_id": {
      "type": "string",
      "description": "ID nad\u0159azen\u00e9ho stroje (pokud je toto pod\u0159\u00edzen\u00e1 sou\u010d\u00e1st/rozvad\u011b\u010d)"
    },
    "name": {
      "type": "string",
      "description": "N\u00e1zev stroje nebo sekce linky"
    },
    "description": {
      "type": "string"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "machine",
        "line_section"
      ],
      "default": "machine",
      "description": "Typ z\u00e1znamu - fyzick\u00fd stroj nebo sekce linky pro \u00fadr\u017ebu"
    },
    "inventory_number": {
      "type": "string",
      "description": "Invent\u00e1rn\u00ed \u010d\u00edslo / intern\u00ed ozna\u010den\u00ed"
    },
    "sensor_id": {
      "type": "string",
      "description": "ID extern\u00edho senzoru (nap\u0159. AISSENS_001)"
    },
    "location": {
      "type": "string",
      "description": "Um\u00edst\u011bn\u00ed stroje (objekt/hala/sekce)"
    },
    "machine_type": {
      "type": "string",
      "enum": [
        "press",
        "conveyor",
        "pump",
        "fan",
        "compressor",
        "motor",
        "gearbox",
        "crane",
        "robot",
        "cnc_machine",
        "welding_machine",
        "switchboard",
        "transformer",
        "other"
      ],
      "description": "Typ za\u0159\u00edzen\u00ed (pouze pro asset_type=machine)"
    },
    "order_index": {
      "type": "number",
      "default": 0
    },
    "vibration_source": {
      "type": "string",
      "enum": [
        "aissens",
        "vse"
      ],
      "default": "aissens",
      "description": "Zdroj dat vibrodiagnostiky: aissens = bezdr\u00e1tov\u00e9 senzory Aissens (MQTT), vse = ifm VSE jednotky p\u0159es OPC UA bridge"
    },
    "vibration_standard_id": {
      "type": "string",
      "description": "ID p\u0159i\u0159azen\u00e9 normy vibrac\u00ed"
    },
    "vibration_schema_id": {
      "type": "string",
      "description": "ID p\u0159i\u0159azen\u00e9ho sch\u00e9matu m\u011b\u0159en\u00ed (tabulky)"
    },
    "vse_counter_map": {
      "type": "string",
      "description": "JSON mapov\u00e1n\u00ed slot\u016f \u0161ablony VSE na prom\u011bnn\u00e9 jednotek. Nap\u0159. {\"X.ok\":{\"unit_id\":\"VSE-01\",\"node_id\":\"ns=2;s=...\",\"name\":\"ObjectState1\"}}"
    },
    "alarm_delay_count": {
      "type": "number",
      "default": 1,
      "description": "Zpo\u017ed\u011bn\u00ed alarmu vibrodiagnostiky \u2014 po\u010det po sob\u011b jdouc\u00edch m\u011b\u0159en\u00ed, kter\u00e1 mus\u00ed p\u0159ekro\u010dit limit, aby se alarm aktivoval (1 = bez zpo\u017ed\u011bn\u00ed)"
    },
    "idle_threshold_percent": {
      "type": "number",
      "default": 10,
      "description": "Pr\u00e1h klidu stroje v % maxima obdob\u00ed \u2014 m\u011b\u0159en\u00ed pod touto hodnotou se v trendu skryj\u00ed p\u0159i volb\u011b 'Jen chod stroje'"
    },
    "motohours_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Po\u010d\u00edtat motohodiny z vibrac\u00ed"
    },
    "motohours_initial": {
      "type": "number",
      "default": 0,
      "description": "Po\u010d\u00e1te\u010dn\u00ed stav po\u010d\u00edtadla motohodin (h)"
    },
    "motohours_from": {
      "type": "string",
      "format": "date-time",
      "description": "Od kdy po\u010d\u00edtat motohodiny"
    },
    "motohours_threshold_mm_s": {
      "type": "number",
      "default": 0.3,
      "description": "Pr\u00e1h chodu stroje (rychlost vibrac\u00ed mm/s)"
    },
    "motohours_accumulated": {
      "type": "number",
      "default": 0,
      "description": "Napo\u010d\u00edtan\u00e9 motohodiny z vibrac\u00ed (h)"
    },
    "motohours_last_ts": {
      "type": "number",
      "description": "Unix \u010das posledn\u00edho zpracovan\u00e9ho m\u011b\u0159en\u00ed"
    },
    "motohours_running": {
      "type": "boolean",
      "description": "Stroj podle posledn\u00edho m\u011b\u0159en\u00ed b\u011b\u017e\u00ed"
    },
    "unbalance_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Sledovat m\u00edru nev\u00fdvahy (amplituda 1\u00d7 z FFT rychlosti)"
    },
    "unbalance_threshold_mm_s": {
      "type": "number",
      "default": 2.8,
      "description": "Prahov\u00e1 hodnota amplitudy 1\u00d7 (mm/s) = 100 % m\u00edry nev\u00fdvahy"
    },
    "unbalance_trend_alarm_days": {
      "type": "number",
      "default": 3,
      "description": "Alarm podle trendu: upozornit, pokud trend p\u0159edpov\u00edd\u00e1 dosa\u017een\u00ed prahu do tolika dn\u00ed (0 = vypnuto)"
    },
    "sensor_orientation_mode": {
      "type": "string",
      "enum": [
        "same",
        "per_point"
      ],
      "default": "same",
      "description": "Orientace sn\u00edma\u010d\u016f: same = v\u0161echny stejn\u011b (glob\u00e1ln\u011b pro stroj), per_point = ka\u017ed\u00fd jinak (u m\u011b\u0159ic\u00edho m\u00edsta)"
    },
    "sensor_orientation": {
      "type": "string",
      "default": "VAH",
      "description": "Glob\u00e1ln\u00ed orientace os X,Y,Z (V=vertik\u00e1ln\u00ed, A=axi\u00e1ln\u00ed, H=horizont\u00e1ln\u00ed), nap\u0159. VAH"
    },
    "vibration_history_from": {
      "type": "string",
      "format": "date-time",
      "description": "Od kdy zobrazovat historii p\u0159i\u0159azen\u00fdch sn\u00edma\u010d\u016f (trendy, FFT spektra, AI anal\u00fdza). Pr\u00e1zdn\u00e9 = cel\u00e1 historie."
    },
    "photo_url": {
      "type": "string",
      "description": "URL fotografie stroje pro vibra\u010dn\u00ed kartu"
    },
    "monitor_vibration": {
      "type": "boolean",
      "default": false,
      "description": "Sledov\u00e1no vibra\u010dn\u00ed diagnostikou"
    },
    "monitor_thermo": {
      "type": "boolean",
      "default": false,
      "description": "Sledov\u00e1no termodiagnostikou"
    },
    "monitor_tribo": {
      "type": "boolean",
      "default": false,
      "description": "Sledov\u00e1no tribodiagnostikou"
    }
  },
  "required": [
    "line_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "superAdmin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "manager"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "superAdmin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "manager"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "data.user_type": "superAdmin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "admin"
          }
        },
        {
          "user_condition": {
            "data.user_type": "manager"
          }
        }
      ]
    }
  }
}