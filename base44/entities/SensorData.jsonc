{
  "name": "SensorData",
  "type": "object",
  "properties": {
    "sensor_id": {
      "type": "string"
    },
    "report_type": {
      "type": "number"
    },
    "timestamp_unix": {
      "type": "number"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "dsp_version": {
      "type": "number"
    },
    "temperature": {
      "type": "number"
    },
    "battery_level": {
      "type": "number"
    },
    "battery_voltage": {
      "type": "number"
    },
    "rssi": {
      "type": "number"
    },
    "interval": {
      "type": "number"
    },
    "oa_x": {
      "type": "number"
    },
    "oa_y": {
      "type": "number"
    },
    "oa_z": {
      "type": "number"
    },
    "oa_acc_z": {
      "type": "number"
    },
    "has_fft": {
      "type": "boolean",
      "default": false
    },
    "has_raw": {
      "type": "boolean",
      "default": false
    },
    "num_samples": {
      "type": "number"
    },
    "raw_x_json": {
      "type": "string"
    },
    "raw_y_json": {
      "type": "string"
    },
    "raw_z_json": {
      "type": "string"
    },
    "mqtt_message_id": {
      "type": "string"
    },
    "rms_z_g": {
      "type": "number"
    },
    "peak_z_g": {
      "type": "number"
    },
    "vel_rms_x_mm_s": {
      "type": "number"
    },
    "vel_rms_y_mm_s": {
      "type": "number"
    },
    "vel_rms_z_mm_s": {
      "type": "number"
    },
    "env_rms_z": {
      "type": "number"
    }
  },
  "required": [
    "sensor_id",
    "report_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "read": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "update": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    }
  }
}