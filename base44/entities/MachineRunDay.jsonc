{
  "name": "MachineRunDay",
  "type": "object",
  "properties": {
    "machine_id": {
      "type": "string",
      "description": "ID stroje"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Den (YYYY-MM-DD)"
    },
    "hours": {
      "type": "number",
      "default": 0,
      "description": "Motohodiny za den"
    }
  },
  "required": [
    "machine_id",
    "date"
  ],
  "rls": {
