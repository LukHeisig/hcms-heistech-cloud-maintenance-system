      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    }
  }
}