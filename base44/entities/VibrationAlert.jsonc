{
  "name": "VibrationAlert",
  "type": "object",
  "properties": {
    "sensor_id": {
      "type": "string"
    },
    "machine_id": {
      "type": "string"
    },
    "machine_name": {
      "type": "string"
    },
    "measurement_point": {
      "type": "string"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "velocity",
        "acceleration",
        "envelope",
        "temperature",
        "battery"
      ]
    },
    "metric_key": {
      "type": "string"
    },
    "metric_label": {
      "type": "string"
    },
    "metric_unit": {
      "type": "string"
    },
    "value": {
      "type": "number"
    },
    "limit_ab": {
      "type": "number"
    },
    "limit_bc": {
      "type": "number"
    },
    "limit_cd": {
      "type": "number"
    },
    "severity": {
      "type": "string",
      "enum": [
        "B",
        "C",
        "D"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged"
      ],
      "default": "active"
    },
    "acknowledged_by": {
      "type": "string"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "acknowledge_note": {
      "type": "string"
    },
    "sensor_data_id": {
      "type": "string"
    }
  },
  "required": [
    "sensor_id",
    "machine_id",
    "alert_type",
    "metric_key",
    "value",
    "severity",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "read": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "update": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "superAdmin"
      }
    }
  }
}